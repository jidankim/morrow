{
  "name": "morrow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri:dev": "VITE_DISABLE_REACT_DEVTOOLS=1 SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk RUSTFLAGS='-C linker=/Library/Developer/CommandLineTools/usr/bin/cc' tauri dev --runner \"$PWD/scripts/tauri-dev-signed-runner.sh\"",
    "tauri:build": "SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk RUSTFLAGS='-C linker=/Library/Developer/CommandLineTools/usr/bin/cc' tauri build",
    "tauri:build:beta": "SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk RUSTFLAGS='-C linker=/Library/Developer/CommandLineTools/usr/bin/cc' tauri build --bundles app,dmg",
    "tauri:build:diagnostic": "scripts/build-diagnostic-artifact.sh",
    "tauri": "tauri",
    "tauri:ios:init": "scripts/tauri-ios-with-rustup.sh init",
    "tauri:ios:dev": "scripts/tauri-ios-with-rustup.sh dev",
    "tauri:ios:build:simulator": "scripts/tauri-ios-with-rustup.sh build --target aarch64-sim --no-sign",
    "tauri:ios:build:device": "scripts/tauri-ios-with-rustup.sh build",
    "tauri:ios:build:app-store": "scripts/tauri-ios-with-rustup.sh build --export-method app-store-connect"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.1",
    "react-grab": "^0.1.47",
    "react-scan": "^0.5.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.6"
  }
}
